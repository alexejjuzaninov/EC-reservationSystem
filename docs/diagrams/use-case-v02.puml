@startuml use-case-v02
title Případy užití, baseline v0.2 (změna C02: schvalování)
left to right direction
skinparam packageStyle rectangle

actor "Zaměstnanec" as emp
actor "Facility admin" as adm
actor "Notification Service" as ns <<system>>

rectangle "Rezervační systém nabíjecích stanic" {
  usecase "Vytvořit rezervaci\n(OP-01)" as UC1
  usecase "Zjistit dostupnost\n(OP-02)" as UC2
  usecase "Potvrdit rezervaci\n(OP-03)" as UC3
  usecase "Zrušit rezervaci\n(OP-04)" as UC4
  usecase "Schválit rezervaci\n(OP-05)" as UC5
  usecase "Zamítnout rezervaci\n(OP-05)" as UC6
}

emp -- UC1
emp -- UC2
emp -- UC3
emp -- UC4
adm -- UC2
adm -- UC4
adm -- UC5
adm -- UC6

UC3 -- ns
UC4 -- ns
UC5 -- ns
UC6 -- ns

@enduml
